# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL (mandatory stack):  postgresql+psycopg2://user:password@localhost:5432/rca_db
# MySQL alternative:             mysql+pymysql://user:password@localhost:3306/rca_db
# Quick local try-out only:      sqlite:///./rca.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rca_db

CORS_ORIGINS=http://localhost:5173
